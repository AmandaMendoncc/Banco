@model IEnumerable<Banco.Models.Core.Conta>
@{
    ViewData["Title"] = "Meu Painel";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <div class="alert alert-warning">Você ainda não possui contas cadastradas.</div>
}
else
{
    <h4>Minhas Contas</h4>
    <div class="list-group">
        @foreach (var conta in Model)
        {
            <div class="list-group-item list-group-item-action flex-column align-items-start">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">@conta.Tipo.ToString()</h5>
                    <small>Agência: @conta.Agencia / Conta: @conta.NumeroConta</small>
                </div>
                <p class="mb-1 h3 text-success">
                    Saldo: @conta.Saldo.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                </p>
                <div class="mt-2">
                    <button class="btn btn-sm btn-primary">Depositar</button>
                    <button class="btn btn-sm btn-secondary">Sacar</button>
                    <button class="btn btn-sm btn-info">Transferir</button>
                </div>
            </div>
        }
    </div>
}